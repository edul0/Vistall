{
  "framework": null,
  "buildCommand": "npm ci --prefix tools/static-build --ignore-scripts --no-fund --no-audit && node scripts/prepare-vercel.mjs",
  "outputDirectory": "vercel-dist",
  "rewrites": [
    {
      "source": "/sobre",
      "destination": "/sobre.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://vistall.nlsites01.workers.dev/api/:path*"
    }
  ],
  "headers": [
    {
      "headers": [
        {
          "value": "nosniff",
          "key": "X-Content-Type-Options"
        },
        {
          "value": "DENY",
          "key": "X-Frame-Options"
        },
        {
          "value": "strict-origin-when-cross-origin",
          "key": "Referrer-Policy"
        },
        {
          "value": "camera=(), microphone=(), geolocation=(), payment=()",
          "key": "Permissions-Policy"
        },
        {
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests",
          "key": "Content-Security-Policy"
        }
      ],
      "source": "/(.*)"
    },
    {
      "headers": [
        {
          "value": "no-store",
          "key": "Cache-Control"
        }
      ],
      "source": "/api/(.*)"
    }
  ]
}